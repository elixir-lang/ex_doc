<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="<%= h(config.language) %>" lang="<%= h(config.language) %>"
      xmlns:epub="http://www.idpf.org/2007/ops">
  <head>
    <meta charset="utf-8" />
    <title><%= h(title) %> - <%= h(config.project) %> v<%= h(config.version) %></title>
    <meta name="generator" content="ExDoc v<%= ExDoc.version() %>" />
    <link type="text/css" rel="stylesheet" href="dist/<%= Assets.css_filename(config.proglang) %>" />
    <script src="dist/<%= Assets.js_filename() %>"></script>
    <%= config.before_closing_head_tag.(:epub) %>
  </head>
  <body class="content-inner">
